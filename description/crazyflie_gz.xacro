<?xml version="1.0"?>
<!--
  Gazebo-specific extensions pour le drone Crazyflie.
  Inclus depuis crazyflie.urdf.xacro via le RSP /drone.

  Plugin de vol : MulticopterVelocityControl (gz-sim8 natif).
  Ce plugin est le CONTRÔLEUR HAUT NIVEAU qui reçoit des commandes Twist
  et calcule les vitesses de rotation cibles de chaque hélice.

  Il doit être couplé obligatoirement avec 4 plugins MulticopterMotorModel
  (un par rotor), qui traduisent ces vitesses cibles en forces physiques
  réelles (poussée + couple) appliquées dans le moteur physique Gazebo.

  Sans les MulticopterMotorModel, le drone reste au sol même si le contrôleur
  haut niveau reçoit les commandes correctement.

  Référence officielle : /usr/share/gz/gz-sim8/worlds/multicopter_velocity_control.sdf
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ======================== MULTICOPTER MOTOR MODEL PLUGINS ======================== -->
  <!--
    Ces 4 plugins traduisent les vitesses de rotation commandées par
    MulticopterVelocityControl en forces physiques (poussée, couple) sur
    chaque hélice. OBLIGATOIRES pour que le drone décolle.
    commandSubTopic doit correspondre au motorControlPubTopic de VelocityControl.
  -->

  <!-- Rotor Front-Left (CCW) -->
  <gazebo>
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_fl_joint</jointName>
      <linkName>rotor_fl_link</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>800.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>0</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </gazebo>

  <!-- Rotor Front-Right (CW) -->
  <gazebo>
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_fr_joint</jointName>
      <linkName>rotor_fr_link</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>800.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>1</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </gazebo>

  <!-- Rotor Back-Left (CW) -->
  <gazebo>
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_bl_joint</jointName>
      <linkName>rotor_bl_link</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>800.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>2</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </gazebo>

  <!-- Rotor Back-Right (CCW) -->
  <gazebo>
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_br_joint</jointName>
      <linkName>rotor_br_link</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>800.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>3</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </gazebo>

  <!-- ======================== MULTICOPTER FLIGHT VELOCITY CONTROL PLUGIN ======================== -->
  <!--
    Contrôleur haut niveau : reçoit les commandes Twist (vx, vy, vz, wz) et
    calcule les vitesses de rotation cibles des hélices.
    Il publie ces vitesses vers les MulticopterMotorModel via le composant
    Actuators (motorControlPubTopic → commandSubTopic des moteurs).

    rotorConfiguration : OBLIGATOIRE, doit encapsuler la liste des rotors.
    Les gains sont conformes à Gazebo Sim 8 (format officiel X3/X4 UAV).
  -->
  <gazebo>
    <plugin filename="gz-sim-multicopter-control-system"
            name="gz::sim::systems::MulticopterVelocityControl">
      <commandSubTopic>cmd_vel</commandSubTopic>
      <enableSubTopic>enable</enableSubTopic>
      <!-- motorControlPubTopic DOIT correspondre aux commandSubTopic des MulticopterMotorModel -->
      <motorControlPubTopic>command/motor_speed</motorControlPubTopic>
      <!-- comLinkName : le lien principal du corps du drone -->
      <comLinkName>base_link</comLinkName>

      <!-- Gains PID conformes au format Gazebo Sim 8 -->
      <velocityGain>2.7 2.7 2.7</velocityGain>
      <attitudeGain>2 3 0.15</attitudeGain>
      <angularRateGain>0.4 0.52 0.18</angularRateGain>
      <maximumLinearAcceleration>2 2 2</maximumLinearAcceleration>
      <maximumLinearVelocity>0.5 0.5 0.5</maximumLinearVelocity>
      <maximumAngularVelocity>1.0 1.0 2.0</maximumAngularVelocity>

      <!-- Bruit de mesure (valeurs issues de la doc officielle Gazebo) -->
      <linearVelocityNoiseMean>0 0 0</linearVelocityNoiseMean>
      <linearVelocityNoiseStdDev>0.1105 0.1261 0.0947</linearVelocityNoiseStdDev>
      <angularVelocityNoiseMean>0 0 0</angularVelocityNoiseMean>
      <angularVelocityNoiseStdDev>0.004 0.004 0.004</angularVelocityNoiseStdDev>

      <!--
        rotorConfiguration OBLIGATOIRE : l'absence de cette balise ou des
        joints manquants rend le plugin inactif (aucune force générée).
        Les positions (armLength, angle) définissent le signe du moment de lacet.
      -->
      <rotorConfiguration>
        <!-- FL : CCW → direction +1 -->
        <rotor>
          <jointName>rotor_fl_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>1</direction>
        </rotor>
        <!-- FR : CW → direction -1 -->
        <rotor>
          <jointName>rotor_fr_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>-1</direction>
        </rotor>
        <!-- BL : CW → direction -1 -->
        <rotor>
          <jointName>rotor_bl_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>-1</direction>
        </rotor>
        <!-- BR : CCW → direction +1 -->
        <rotor>
          <jointName>rotor_br_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>1</direction>
        </rotor>
      </rotorConfiguration>
    </plugin>
  </gazebo>

  <!-- ======================== POSE PUBLISHER PLUGIN ======================== -->
  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
    </plugin>
  </gazebo>

  <!-- ======================== DOWNWARD CAMERA (Gazebo sensor) ======================== -->
  <gazebo reference="camera_link">
    <sensor name="drone_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>/drone/camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>20</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- Matériaux visuels du corps -->
  <gazebo reference="body_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="rotor_fl_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="rotor_fr_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="rotor_bl_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="rotor_br_link">
    <material>Gazebo/Blue</material>
  </gazebo>

</robot>
